  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Gusts of cold autumn wind stirred you from your sleep.


    Not a soul
    in sight. Only the sound of the sea and the wind wandering among the cliffs.


    You
    remember neither who you are, nor how you came to be here.


    But does it
    really matter?'
  m_isRightToLeft: 0
