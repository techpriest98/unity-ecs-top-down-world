#pragma kernel CSMain


// ============================================================
// GPU data
// ============================================================

struct ProjectedCellGpuData
{
    uint BlockData;
    uint Position;
    uint LightData;
    uint Reserved;
};

struct BlockGpuData
{
    uint AtlasPosition;
    uint Flags;
};


StructuredBuffer<ProjectedCellGpuData> _ProjectedCells;
StructuredBuffer<BlockGpuData> _BlockDatabase;

Texture2D<float4> _BlockAtlas;
RWTexture2D<float4> _Result;

int _ProjectedCellCount;
int _BlockDatabaseCount;


// ============================================================
// Constants
// ============================================================

static const uint OUTPUT_TILE_WIDTH = 16;
static const uint OUTPUT_TILE_HEIGHT = 8;
static const uint FACE_COUNT = 3;


// ============================================================
// Packed projected-cell data
// ============================================================

uint GetBlockId(uint blockData)
{
    return blockData & 0xFF;
}

uint GetFaceType(uint blockData)
{
    return (blockData >> 8) & 0xFF;
}

uint2 UnpackPosition(uint packedPosition)
{
    return uint2(
        packedPosition & 0xFFFF,
        (packedPosition >> 16) & 0xFFFF);
}


// ============================================================
// Block database
// ============================================================

uint2 UnpackAtlasPosition(uint atlasPosition)
{
    return uint2(
        atlasPosition & 0xFF,
        (atlasPosition >> 8) & 0xFF);
}


// ============================================================
// Face mapping
// ============================================================

bool TryGetFaceIndex(
    uint faceType,
    out uint faceIndex)
{
    switch (faceType)
    {
        case 1: // Top
            faceIndex = 0;
            return true;

        case 2: // SideUpper
            faceIndex = 1;
            return true;

        case 3: // SideLower
            faceIndex = 2;
            return true;

        default:
            faceIndex = 0;
            return false;
    }
}


// ============================================================
// Temporary face lighting
// ============================================================

float GetFaceBrightness(uint faceIndex)
{
    switch (faceIndex)
    {
        case 0: // Top
            return 1.0;

        case 1: // SideUpper
        case 2: // SideLower
            return 0.65;

        default:
            return 1.0;
    }
}


// ============================================================
// Kernel
// ============================================================

[numthreads(64, 1, 1)]
void CSMain(
    uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint cellIndex =
        dispatchThreadId.x;

    if (cellIndex >= (uint)_ProjectedCellCount)
    {
        return;
    }

    ProjectedCellGpuData cell =
        _ProjectedCells[cellIndex];

    uint blockId =
        GetBlockId(cell.BlockData);

    if (blockId == 0 ||
        blockId >= (uint)_BlockDatabaseCount)
    {
        return;
    }

    uint faceType =
        GetFaceType(cell.BlockData);

    uint faceIndex;

    if (!TryGetFaceIndex(
            faceType,
            faceIndex))
    {
        return;
    }

    BlockGpuData block =
        _BlockDatabase[blockId];

    uint2 atlasOffset =
        UnpackAtlasPosition(
            block.AtlasPosition);

    uint2 cellPosition =
        UnpackPosition(
            cell.Position);

    uint textureWidth;
    uint textureHeight;

    _Result.GetDimensions(
        textureWidth,
        textureHeight);

    uint startX =
        cellPosition.x *
        OUTPUT_TILE_WIDTH;

    uint requiredHeight =
        (cellPosition.y + 1) *
        OUTPUT_TILE_HEIGHT;

    if (requiredHeight > textureHeight)
    {
        return;
    }

    uint startY =
        textureHeight -
        requiredHeight;

    if (startX + OUTPUT_TILE_WIDTH >
        textureWidth)
    {
        return;
    }

    uint atlasStartX =
        atlasOffset.x *
        OUTPUT_TILE_WIDTH;

    uint atlasStartY =
        atlasOffset.y *
        OUTPUT_TILE_HEIGHT *
        FACE_COUNT +
        (FACE_COUNT - 1 - faceIndex) *
        OUTPUT_TILE_HEIGHT;

    float faceBrightness =
        GetFaceBrightness(
            faceIndex);

    for (uint localY = 0;
         localY < OUTPUT_TILE_HEIGHT;
         localY++)
    {
        uint outputY =
            startY + localY;

        uint atlasY =
            atlasStartY + localY;

        for (uint localX = 0;
             localX < OUTPUT_TILE_WIDTH;
             localX++)
        {
            uint outputX =
                startX + localX;

            uint atlasX =
                atlasStartX + localX;

            float4 color =
                _BlockAtlas.Load(
                    int3(
                        atlasX,
                        atlasY,
                        0));

            color.rgb *=
                faceBrightness;

            color.a = 1.0;

            _Result[
                int2(
                    outputX,
                    outputY)] = color;
        }
    }
}